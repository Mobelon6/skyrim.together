+struct QuestAliasReadGuard
+{
+    BSReadWriteLock& Lock;
+    explicit QuestAliasReadGuard(BSReadWriteLock& lock):Lock(lock) {Lock.LockForRead();}
+    ~QuestAliasReadGuard(){Lock.UnlockRead();}
+};

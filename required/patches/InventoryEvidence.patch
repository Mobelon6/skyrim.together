+void CaptureQuestItem(ExtraDataList* extra,TESObjectREFR* object,TESForm* base,InventoryChangeEvent& event,bool allowStopped)
+{
+    if (!extra||!base||ScopedExtraDataOverride::IsOverriden()) return;
+    if (object&&object->IsTemporary()) return;
+    uint32_t questId{},aliasId{};
+    {
+        QuestAliasReadGuard extraGuard(extra->lock);
+        // The list is already locked. Do not acquire the same lock again.
+        ScopedExtraDataOverride scope;
+        auto* data=extra->GetByType(ExtraDataType::AliasInstanceArray);
+        if (!data) return;
+        auto* aliases=static_cast<QuestObjectAliasArray*>(data);
+        QuestAliasReadGuard aliasGuard(aliases->Lock);
+        if (!aliases->Aliases.data||aliases->Aliases.length>aliases->Aliases.capacity||
+            aliases->Aliases.length>128) return;
+        for (const auto* instance:aliases->Aliases)
+        {
+            if (!instance||!instance->Quest||!instance->Alias) continue;
+            const auto* alias=instance->Alias;
+            if (alias->Owner!=instance->Quest||!(alias->Flags&4u)||(!allowStopped&&instance->Quest->IsStopped())) continue;
+            const auto id=instance->Quest->formID;
+            if (!id) continue;
+            // Do not choose arbitrarily between different active quest aliases.
+            if (questId&&(questId!=id||aliasId!=alias->Id)) return;
+            questId=id;aliasId=alias->Id;
+        }
+    }
+    if (!questId) return;
+    // In inventory, resolve the exact reference selected by the native alias.
+    // Do not infer its identity from an ordinary item of the same base type.
+    auto* owner=Cast<TESQuest>(TESForm::GetById(questId));
+    auto* assigned=owner&&(allowStopped||!owner->IsStopped())?owner->GetAliasedRef(aliasId):nullptr;
+    if (!assigned||(object&&object!=assigned)) return;
+    object=assigned;
+    if (object->IsTemporary()||object->baseForm!=base) return;
+    GameId quest{},reference{};
+    auto& mods=World::Get().GetModSystem();
+    if (!mods.GetServerModId(questId,quest)||!mods.GetServerModId(object->formID,reference)||
+        !quest||!reference) return;
+    event.QuestId=quest;
+    event.QuestRef=reference;
+    event.QuestAlias=aliasId;
+}
+
+namespace
+{
+void CaptureQuestPickup(TESObjectREFR* object,InventoryChangeEvent& event)
+{
+    if (object) CaptureQuestItem(object->GetExtraDataList(),object,object->baseForm,event);
+}

+void OverlayService::UpdateDialogueHud() noexcept
+{
+    const auto now = std::chrono::steady_clock::now();
+    if (now < m_nextDialogueHud)
+        return;
+    m_nextDialogueHud = now + 100ms;
+    if (m_conversations.empty())
+    {
+        ClearDialogueHud();
+        return;
+    }
+    auto* pPlayer = PlayerCharacter::Get();
+    const auto* pMenu = MenuTopicManager::Get();
+    const auto& party = m_world.GetPartyService();
+    if (!pPlayer || !pPlayer->parentCell || !party.IsInParty() || !m_pOverlay || m_active ||
+        !m_inGame || (pMenu && pMenu->menuOpen))
+    {
+        ClearDialogueHud();
+        return;
+    }
+
+    const auto& members = party.GetPartyMembers();
+    const auto* pCell = pPlayer->GetParentCellEx();
+    const auto* pWorld = pPlayer->GetWorldSpace();
+    const NotifyPlayerDialogue* pSelected = nullptr;
+    bool sameSpace = false;
+    float nearest = std::numeric_limits<float>::max();
+    Vector<uint32_t> expired;
+    for (const auto& [id, conversation] : m_conversations)
+        if (conversation.Expires <= now || std::find(members.begin(), members.end(), id) == members.end())
+            expired.push_back(id);
+    for (auto id : expired)
+        m_conversations.erase(id);
+
+    for (const auto& [id, conversation] : m_conversations)
+    {
+        const auto& message = conversation.Last;
+        auto& mods = m_world.GetModSystem();
+        const auto& anchor = message.Anchor;
+        const bool shared = anchor.WorldSpace ? pWorld && mods.GetGameId(anchor.WorldSpace) == pWorld->formID
+                                              : !pWorld && pCell && mods.GetGameId(anchor.Cell) == pCell->formID;
+        const float distance = shared ? glm::distance(static_cast<const glm::vec3&>(pPlayer->position), static_cast<const glm::vec3&>(anchor.Position))
+                                      : std::numeric_limits<float>::max();
+        if (!pSelected || distance < nearest || (distance == nearest && id == party.GetLeaderPlayerId()))
+        {
+            pSelected = &message;
+            nearest = distance;
+            sameSpace = shared;
+        }
+    }
+    if (!pSelected)
+    {
+        ClearDialogueHud();
+        return;
+    }
+
+    // Mode 0: another space, 1: visible marker, 2: edge arrow, 3: listening nearby.
+    int mode = 0;
+    double dx = 0., dy = 0.;
+    if (sameSpace && nearest <= 350.f && !pPlayer->IsInCombat())
+        mode = 3;
+    else if (sameSpace)
+    {
+        const glm::vec3 target = static_cast<const glm::vec3&>(pSelected->Anchor.Position) + glm::vec3{0.f, 0.f, 100.f};
+        NiPoint3 projected{};
+        bool front = HUDMenuUtils::WorldPtToScreenPt3(target, projected) && projected.z >= 0.f;
+        if (!front)
+        {
+            // Reflect around the local viewpoint to get a stable direction for a point behind the camera.
+            const glm::vec3 eye = static_cast<const glm::vec3&>(pPlayer->position) + glm::vec3{0.f, 0.f, pPlayer->GetHeight()};
+            if (!HUDMenuUtils::WorldPtToScreenPt3(eye + (eye - target), projected))
+                projected = glm::vec3{0.5f, 1.f, 0.f};
+        }
+        dx = (projected.x - 0.5) * (front ? 2. : -2.);
+        dy = (0.5 - projected.y) * (front ? 2. : -2.);
+        if (!std::isfinite(dx) || !std::isfinite(dy))
+        {
+            dx = 0.;
+            dy = 1.;
+        }
+        mode = front && std::abs(dx) <= 0.90 && std::abs(dy) <= 0.88 ? 1 : 2;
+        if (mode == 2)
+        {
+            if (std::abs(dx) + std::abs(dy) < 0.001)
+                dy = 1.;
+            const double edge = std::max(std::abs(dx) / 0.90, std::abs(dy) / 0.88);
+            dx /= edge;
+            dy /= edge;
+        }
+    }
+    auto args = CefListValue::Create();
+    args->SetInt(0, mode);
+    args->SetDouble(1, (dx + 1.) * 50.);
+    args->SetDouble(2, (dy + 1.) * 50.);
+    args->SetString(3, pSelected->Name.c_str());
+    args->SetString(4, mode == 3 ? pSelected->Text.c_str() : "");
+    args->SetDouble(5, pSelected->SpeakerId);
+    args->SetDouble(6, pSelected->Anchor.Session);
+    args->SetDouble(7, pSelected->Anchor.Choice);
+    m_pOverlay->ExecuteAsync("partyConversation", args);
+    m_dialogueHudVisible = true;
 }
 

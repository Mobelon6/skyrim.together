+  background: currentColor;
+  &::after {
+    content: '';
+    position: absolute;
+    left: .16rem;
+    bottom: -.19rem;
+    border-top: .23rem solid currentColor;
+    border-right: .26rem solid transparent;
+  }
+}
+.conversation-bearing {
+  position: absolute;
+  inset: -.57rem;
+  &::before {
+    content: '';
+    position: absolute;
+    left: 50%;
+    transform: translateX(-50%);
+    border-bottom: .41rem solid currentColor;
+    border-left: .27rem solid transparent;
+    border-right: .27rem solid transparent;
+  }
+}
+.conversation-speaker {
+  position: absolute;
+  top: calc(100% + .25rem);
+  font-size: .86rem;
+  white-space: nowrap;
+}
+.conversation-reply {
+  top: 54%;
+  right: 8%;
+  max-width: 36%;
+  line-height: 1.3;
+  font-size: 1.25rem;
+  overflow-wrap: anywhere;
+  animation: conversation-reply-fade 5s both;
+}
+@keyframes conversation-reply-fade {
+  0%, 76% { opacity: 1; }
+  100% { opacity: 0; }
+}

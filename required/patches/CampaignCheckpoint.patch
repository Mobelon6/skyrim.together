+void ObserveLearnedWord(World& world,uint64_t character,RequestCampaignPull& request)
+{
+    auto sample=CaptureWordSample(world,character);
+    if (!sample) {wordBaseline.reset();pendingWord.reset();return;}
+    if (pendingWord)
+    {
+        const auto grants=QuestWordReward::Read(campaignLink.Journal.Operations());
+        if (!grants||pendingWord->Character!=character||pendingWord->Peer!=sample->Peer||
+            pendingWord->Cell!=sample->Cell||QuestWordReward::Entitled(*grants,pendingWord->Word,character))
+            pendingWord.reset();
+        else
+        {
+            request.LearnedWord=pendingWord->Word.c_str();request.WordPeer=pendingWord->Peer;
+            request.WordCellMod=pendingWord->CellMod;request.WordCellBase=pendingWord->CellBase;
+            return; // do not advance the baseline before an acknowledged observation
+        }
+    }
+    if (!wordBaseline) return; // seed only after the server confirms a full prefix
+    const auto word=QuestWordReward::NewWord(*wordBaseline,*sample);
+    wordBaseline=sample;
+    if (!word) return;
+    std::vector<InventoryEvidence::PluginSlot> slots;
+    for (const auto* mod:ModManager::Get()->mods)
+    {
+        if (!mod||!mod->IsLoaded()) continue;
+        const auto* end=std::find(mod->filename,mod->filename+sizeof(mod->filename),'\0');
+        if (end!=mod->filename+sizeof(mod->filename))
+            slots.push_back({mod->GetId(),mod->IsLite(),std::string(mod->filename,end)});
+    }
+    const auto stable=InventoryEvidence::Resolve(*word,slots);
+    if (!stable) return;
+    const TradeProperties::FormKey key{stable->Plugin,stable->Local};
+    GameId cell{};
+    if (!key.Valid()||!world.GetModSystem().GetServerModId(sample->Cell,cell)) return;
+    request.LearnedWord=key.Encode().c_str();
+    pendingWord=PendingWord{key.Encode(),character,sample->Peer,sample->Cell,cell.ModId,cell.BaseId};
+    request.WordPeer=sample->Peer;request.WordCellMod=cell.ModId;request.WordCellBase=cell.BaseId;
+}

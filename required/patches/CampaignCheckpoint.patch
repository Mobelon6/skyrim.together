diff --git a/Code/common/QuestPickupPermit.h b/Code/common/QuestPickupPermit.h
new file mode 100644
--- /dev/null
+++ b/Code/common/QuestPickupPermit.h
@@ -0,0 +1,112 @@
+#pragma once
+#include <CampaignJournal.h>
+#include <TradeProperties.h>
+#include <chrono>
+#include <map>
+#include <optional>
+#include <sstream>
+#include <string>
+
+namespace QuestPickupPermit
+{
+struct Claim
+{
+    std::string Quest, Reference, Item;
+    uint32_t Alias{};
+    bool Valid() const
+    {
+        for (const auto* value:{&Quest,&Reference,&Item})
+        {
+            const auto key=TradeProperties::DecodeForm(*value);
+            if (!key||!key->Valid()||key->Encode()!=*value) return false;
+        }
+        return true;
+    }
+    std::string Encode() const {return Quest+" "+std::to_string(Alias)+" "+Reference+" "+Item;}
+};
+inline std::optional<Claim> Decode(const std::string& value)
+{
+    if (value.size()>768) return {};
+    Claim claim;
+    std::string extra;
+    std::istringstream in(value);
+    if (!(in>>claim.Quest>>claim.Alias>>claim.Reference>>claim.Item)||in>>extra||
+        !claim.Valid()||claim.Encode()!=value) return {};
+    return claim;
+}
+struct Receipt
+{
+    Claim Object;
+    int32_t Count{};
+    bool Initial{};
+    bool Valid() const
+    {return Object.Valid()&&(Count==1||Count==-1)&&(!Initial||Count==1);}
+    std::string Encode() const
+    {return Object.Encode()+" "+std::to_string(Count)+" "+std::to_string(Initial?1:0);}
+};
+inline std::optional<Receipt> DecodeReceipt(const std::string& value)
+{
+    if (value.size()>800) return {};
+    Receipt receipt;
+    auto& c=receipt.Object;
+    unsigned initial{};
+    std::string extra;
+    std::istringstream row(value);
+    if (!(row>>c.Quest>>c.Alias>>c.Reference>>c.Item>>receipt.Count>>initial)||row>>extra||initial>1) return {};
+    receipt.Initial=initial==1;
+    if (!receipt.Valid()||receipt.Encode()!=value) return {};
+    return receipt;
+}
+inline std::string Payload(const Claim& c,uint64_t character)
+{
+    return c.Quest+" 1 "+std::to_string(c.Alias)+" "+c.Reference+" "+c.Item+" 1 "+std::to_string(character);
+}
+inline bool Acknowledged(const std::vector<CampaignJournal::Operation>& ops,const Receipt& receipt,uint64_t character)
+{
+    if (!character||!receipt.Valid()) return false;
+    const auto own=Payload(receipt.Object,character);
+    const auto prefix=own.substr(0,own.rfind(' ')+1);
+    bool holder=false,spent=false;
+    for (const auto& op:ops)
+    {
+        if ((op.Kind=="quest-pickup-v1"||op.Kind=="quest-copy-v1")&&op.Payload==own) holder=true;
+        if ((op.Kind=="quest-consumed-v1"||op.Kind=="quest-consumed-v2")&&op.Payload.starts_with(prefix)) spent=true;
+    }
+    return holder&&(receipt.Count==1||spent);
+}
+// Even if the quest has since finished, an old physical reference cannot
+// be acquired again by this shared first-run path.
+inline bool AlreadyTaken(const std::vector<CampaignJournal::Operation>& ops,const Claim& claim)
+{
+    for (const auto& op:ops)
+        if (op.Kind=="quest-pickup-v1")
+        {
+            std::string q,ref,item,extra;uint32_t generation{},alias{};int count{};uint64_t owner{};
+            std::istringstream in(op.Payload);
+            if (!(in>>q>>generation>>alias>>ref>>item>>count>>owner)||in>>extra||
+                !generation||count<=0||!owner) return true;
+            if (ref==claim.Reference||(q==claim.Quest&&generation==1&&alias==claim.Alias)) return true;
+        }
+    return false;
+}
+struct Leases
+{
+    using Clock=std::chrono::steady_clock;
+    struct Lease {std::string ClaimKey;uint64_t Character{};Clock::time_point Until;};
+    std::map<std::string,Lease> Active;
+    bool Acquire(const Claim& claim,uint64_t character,Clock::time_point now)
+    {
+        if (!character||!claim.Valid()) return false;
+        for (auto it=Active.begin();it!=Active.end();)
+            if (it->second.Until<=now) it=Active.erase(it);else ++it;
+        const auto key=claim.Encode();
+        const auto alias=claim.Quest+" "+std::to_string(claim.Alias)+" ";
+        for (const auto& [ref,lease]:Active)
+            if (ref==claim.Reference||lease.ClaimKey.starts_with(alias))
+                return lease.Character==character&&lease.ClaimKey==key;
+        if (Active.size()>=64) return false;
+        Active.emplace(claim.Reference,Lease{key,character,now+std::chrono::seconds(30)});
+        return true;
+    }
+};
+}

diff --git a/Code/common/QuestRunMember.h b/Code/common/QuestRunMember.h
new file mode 100644
--- /dev/null
+++ b/Code/common/QuestRunMember.h
@@ -0,0 +1,68 @@
+#pragma once
+#include <charconv>
+#include <cstdint>
+#include <istream>
+#include <map>
+#include <optional>
+#include <string>
+#include <utility>
+
+namespace QuestRunMember
+{
+// Keep the full instance history, not just the latest binding. Loading an
+// earlier ESS must not let a previously consumed instance open another run.
+using Members = std::map<uint64_t,std::map<uint32_t,uint32_t>>; // character -> instance -> generation
+inline bool ReadTail(std::istream& in,std::string& targets,std::optional<uint32_t>& instance)
+{
+    targets.clear();instance.reset();
+    std::string token,extra;
+    if (!(in>>token)) return true;
+    if (!token.starts_with('@'))
+    {
+        targets=std::move(token);
+        if (!(in>>token)) return true;
+    }
+    if (!token.starts_with('@')||token.size()<2||in>>extra) return false;
+    uint32_t id{};
+    const auto result=std::from_chars(token.data()+1,token.data()+token.size(),id);
+    if (result.ec!=std::errc{}||result.ptr!=token.data()+token.size()||
+        token!="@"+std::to_string(id)) return false;
+    instance=id;
+    return true;
+}
+inline std::optional<uint32_t> Instance(const Members& members,uint64_t character,uint32_t generation)
+{
+    const auto it=members.find(character);
+    if (it!=members.end())
+        for (const auto& [instance,run]:it->second)
+            if (run==generation) return instance;
+    return {};
+}
+inline bool Bound(const Members& members,uint64_t character,uint32_t generation,uint32_t instance)
+{
+    return Instance(members,character,generation)==instance;
+}
+inline bool Remember(Members& members,uint64_t character,uint32_t generation,uint32_t instance)
+{
+    if (!character||!generation) return false;
+    if (const auto old=Instance(members,character,generation)) return *old==instance;
+    auto& history=members[character];
+    if (history.contains(instance)) return false;
+    for (const auto& [id,run]:history) if (run>generation) return false;
+    history.emplace(instance,generation);
+    return true;
+}
+inline bool Admit(const Members& members,uint64_t character,uint32_t generation,uint32_t instance,
+    bool stopped,bool start,bool stage,bool legacyDifferentTargets)
+{
+    if (!character||!generation) return false;
+    const auto it=members.find(character);
+    const auto current=Instance(members,character,generation);
+    const bool used=it!=members.end()&&it->second.contains(instance);
+    if (stopped)
+        return start&&!used&&(current.has_value()||(members.empty()&&legacyDifferentTargets));
+    if (current) return *current==instance;
+    if (used) return false;
+    return start||(generation==1&&stage);
+}
+}

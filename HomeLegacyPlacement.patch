+            auto b=TradeProperties::DecodeForm(base);
+            if (!b || row>>extra) return {};
+            d.Value.Base=*b;d.Value.Variant=variant=="-"?"":variant;
+            if (!d.Valid()) return {};
+            s.Legacy.push_back(std::move(d));
+        }
+        else if (tag=="I" && !s.Refs.empty() && s.Legacy.empty())

+    const auto dy=p->position.y-std::bit_cast<float>(pos[1]);
+    const auto dz=p->position.z-std::bit_cast<float>(pos[2]);
+    return std::isfinite(dx+dy+dz)&&dx*dx+dy*dy+dz*dz<=4096.f;
+}

+            !character || status > NotifyQuestUpdate::Stopped || stage > UINT16_MAX || type > UINT8_MAX)
+            return false;
+        std::string targets;
+        std::optional<uint32_t> instance;
+        if (!QuestRunMember::ReadTail(row,targets,instance)||!ValidQuestTargets(targets)) return false;
+        if (binding)

+    selection=false;door=0;options.clear();accessMenu={};visit={};lockContext={};projectedRoot.store(0);ads.clear();SetVisit(0,0);refresh={};self.store(invalid);
+    activeHomeRoute.store(0);acknowledgedHome={};baselineUpload={};
+    for (unsigned i=0;i<routeCount.load();++i) routes[i].own.store(0);

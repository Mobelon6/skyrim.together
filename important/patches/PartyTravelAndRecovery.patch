diff --git a/Code/server/Services/PartyTravel.cpp b/Code/server/Services/PartyTravel.cpp
new file mode 100644
index 0000000..b23bbe2
--- /dev/null
+++ b/Code/server/Services/PartyTravel.cpp
@@ -0,0 +1,125 @@
+#include <GameServer.h>
+#include <Services/OverlayService.h>
+#include <Messages/PartyTravelRequest.h>
+#include <Events/UpdateEvent.h>
+#include <Game/Player.h>
+#include <cmath>
+
+namespace
+{
+using Clock = std::chrono::steady_clock;
+bool Within(const glm::vec3& a, const glm::vec3& b, float radius)
+{
+    const auto delta = a - b;
+    return glm::dot(delta, delta) <= radius * radius;
+}
+}
+
+void OverlayService::OnPartyTravel(const PacketEvent<PartyTravelRequest>& event) noexcept
+{
+    auto& sender = *event.pPlayer;
+    const auto& packet = event.Packet;
+    const auto party = sender.GetParty().JoinedPartyId;
+    if (!party || !packet.Trip || !sender.GetCharacter())
+        return;
+
+    if (packet.Action == BoardCarriage)
+    {
+        if (m_rides.count(sender.GetId()))
+            return;
+        const auto* origin = m_world.try_get<MovementComponent>(*sender.GetCharacter());
+        const auto& cell = sender.GetCellComponent();
+        if (!origin || !cell.WorldSpaceId)
+            return;
+        Ride ride;
+        ride.number = packet.Trip;
+        ride.party = *party;
+        ride.origin = origin->Position;
+        ride.originWorld = cell.WorldSpaceId;
+        ride.expires = Clock::now() + std::chrono::minutes(3);
+        NotifyPartyTravel invite;
+        invite.Rider = sender.GetId();
+        invite.Trip = packet.Trip;
+        invite.Name = sender.GetUsername();
+        invite.Kind = InvitePassenger;
+        for (auto* guest : m_world.GetPlayerManager())
+        {
+            if (guest == &sender || guest->GetParty().JoinedPartyId != party || !guest->GetCharacter()
+                || guest->GetCellComponent().WorldSpaceId != cell.WorldSpaceId)
+                continue;
+            auto* movement = m_world.try_get<MovementComponent>(*guest->GetCharacter());
+            if (movement && Within(ride.origin, movement->Position, 1200.f))
+            {
+                ride.passengers.emplace(guest->GetId(), false);
+                guest->Send(invite);
+            }
+        }
+        if (!ride.passengers.empty())
+            m_rides.emplace(sender.GetId(), std::move(ride));
+        return;
+    }
+    auto i = m_rides.find(packet.Rider);
+    if (i == m_rides.end() || i->second.party != *party || i->second.number != packet.Trip || Clock::now() >= i->second.expires)
+        return;
+    auto& ride = i->second;
+    if (sender.GetId() == packet.Rider)
+    {
+        if (packet.Action == CancelCarriage)
+            ride.expires = Clock::now();
+        else if (packet.Action == ArriveByCarriage && !ride.destination.Cell && packet.Cell && packet.World == ride.originWorld
+                 && std::isfinite(packet.Position.x) && std::isfinite(packet.Position.y) && std::isfinite(packet.Position.z)
+                 && !Within(packet.Position, ride.origin, 4096.f))
+        {
+            ride.destination.Kind = TransportPassenger;
+            ride.destination.Rider = packet.Rider;
+            ride.destination.Trip = packet.Trip;
+            ride.destination.Cell = packet.Cell;
+            ride.destination.World = packet.World;
+            ride.destination.Position = packet.Position;
+        }
+    }
+    else if (auto member = ride.passengers.find(sender.GetId()); member != ride.passengers.end())
+    {
+        if (packet.Action == AcceptCarriage)
+            member->second = true;
+        else if (packet.Action == DeclineCarriage)
+            ride.passengers.erase(member);
+    }
+}
+
+void OverlayService::UpdateRides(const UpdateEvent&) noexcept
+{
+    for (auto i = m_rides.begin(); i != m_rides.end(); )
+    {
+        auto& ride = i->second;
+        auto* rider = m_world.GetPlayerManager().GetById(i->first);
+        bool ended = Clock::now() >= ride.expires || !rider || rider->GetParty().JoinedPartyId != ride.party;
+        for (auto member = ride.passengers.begin(); member != ride.passengers.end(); )
+        {
+            auto* guest = m_world.GetPlayerManager().GetById(member->first);
+            if (!guest || guest->GetParty().JoinedPartyId != ride.party || ended)
+            {
+                if (guest)
+                {
+                    NotifyPartyTravel cancel;
+                    cancel.Kind = CancelPassenger;
+                    cancel.Rider = i->first;
+                    cancel.Trip = ride.number;
+                    guest->Send(cancel);
+                }
+            }
+            else if (member->second && ride.destination.Cell)
+                guest->Send(ride.destination);
+            else
+            {
+                ++member;
+                continue;
+            }
+            member = ride.passengers.erase(member);
+        }
+        if (ride.passengers.empty())
+            i = m_rides.erase(i);
+        else
+            ++i;
+    }
+}
diff --git a/Code/server/Services/QuestJournal.cpp b/Code/server/Services/QuestJournal.cpp
new file mode 100644
index 0000000..c4cd381
--- /dev/null
+++ b/Code/server/Services/QuestJournal.cpp
@@ -0,0 +1,96 @@
+#include <GameServer.h>
+#include <World.h>
+#include <Game/Player.h>
+#include <Services/QuestService.h>
+#include <Messages/RequestQuestJournal.h>
+#include <Messages/NotifyQuestJournal.h>
+#include <Messages/NotifyQuestUpdate.h>
+#include <QuestJournalDisk.h>
+#include <sstream>
+#include <iomanip>
+
+namespace
+{
+const std::filesystem::path kJournal{"config/CoopJournal"};
+
+std::string Field(const String& value)
+{
+    std::string out(value.begin(), value.end());
+    for (auto& c : out)
+        if (static_cast<unsigned char>(c) < 32)
+            c = ' ';
+    return out;
+}
+
+void Flush(PartyService::Party& party)
+{
+    if (!party.JournalStream)
+        party.JournalStream = QuestJournalDisk::CreateStream(kJournal);
+    if (!party.JournalStream)
+        return;
+    // Limit recovery work per request after a transient disk failure.
+    for (unsigned n = 0; n < 8 && party.JournalCommitted < party.JournalRows.size(); ++n)
+    {
+        const auto& row = party.JournalRows[party.JournalCommitted];
+        if (!QuestJournalDisk::Store(kJournal, party.JournalStream, party.JournalCommitted + 1, {row.data(), row.size()}))
+        {
+            spdlog::error("Cannot commit co-op journal stream {} record {}", party.JournalStream, party.JournalCommitted + 1);
+            break;
+        }
+        ++party.JournalCommitted;
+    }
+}
+}
+
+void QuestService::RecordQuest(Player* player, const NotifyQuestUpdate& event) noexcept
+{
+    auto* party = m_world.GetPartyService().GetPlayerParty(player);
+    if (!party)
+        return;
+    try
+    {
+        const auto& mods = m_world.ctx().at<ModsComponent>();
+        std::string plugin;
+        for (const auto* list : {&mods.GetStandardMods(), &mods.GetLiteMods()})
+            for (const auto& item : *list)
+                if (item.second.id == event.Id.ModId)
+                    plugin = Field(item.first);
+        const char* phase = event.Status == NotifyQuestUpdate::Started ? "start" :
+            event.Status == NotifyQuestUpdate::Stopped ? "stop" : "stage";
+        std::ostringstream row;
+        row << "quest-v1" << '	' << plugin << '	' << std::hex << event.Id.BaseId << std::dec << '	'
+            << phase << '	' << event.Stage << '	' << player->GetId() << '	' << Field(player->GetUsername());
+        const auto data = row.str();
+        party->JournalRows.emplace_back(data.c_str());
+        Flush(*party);
+    }
+    catch (const std::exception& e) { spdlog::error("Writing co-op quest journal: {}", e.what()); }
+}
+
+void QuestService::OnJournalRequest(const PacketEvent<RequestQuestJournal>& event) noexcept
+{
+    auto* party = m_world.GetPartyService().GetPlayerParty(event.pPlayer);
+    if (!party || party->JournalRows.empty())
+        return;
+    try
+    {
+        Flush(*party);
+        if (!party->JournalStream || !party->JournalCommitted)
+            return;
+        NotifyQuestJournal reply;
+        reply.Stream = party->JournalStream;
+        reply.Total = party->JournalCommitted;
+        if (event.Packet.Stream != reply.Stream)
+        {
+            event.pPlayer->Send(reply); // announce stream identity before the client reads its durable cursor
+            return;
+        }
+        for (uint32_t index = event.Packet.Sequence, n = 0; index < reply.Total && n < 8; ++index, ++n)
+        {
+            reply.Sequence = index + 1;
+            reply.Row = party->JournalRows[index];
+            event.pPlayer->Send(reply);
+        }
+    }
+    catch (const std::exception& e) { spdlog::error("Serving co-op quest journal: {}", e.what()); }
+}

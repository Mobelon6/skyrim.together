-        acMessage.IsDead ? pActor->Kill() : pActor->Respawn();
+        acMessage.IsDead ? pActor->Kill() : pActor->RestoreRemoteLife();
     }
 }
+
+void ActorValueService::OnLifeCheck(const NotifyNpcLifeCheck& packet) const noexcept
+{
+    const auto entity = OwnershipSystem::AcceptOwnerUpdate(m_world, packet.Id, packet.OwnershipEpoch);
+    const auto* form = entity ? m_world.try_get<FormIdComponent>(*entity) : nullptr;
+    auto* actor = form ? Cast<Actor>(TESForm::GetById(form->Id)) : nullptr;
+    if (!actor || !actor->GetNiNode() || !actor->GetExtension() || actor->GetExtension()->IsPlayer())
+        return;
+    RequestDeathStateChange answer;
+    answer.Id = packet.Id;
+    answer.OwnershipEpoch = packet.OwnershipEpoch;
+    answer.IsDead = actor->IsDead();
+    m_transport.Send(answer);
+}

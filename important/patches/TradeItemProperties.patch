+bool UnambiguousBase(const TESObjectREFR& object,uint32_t id)
+{
+    if (const auto* base=object.GetContainer())
+    {
+        if (base->count && !base->entries) return false;
+        for (uint32_t i=0;i<base->count;++i)
+        {

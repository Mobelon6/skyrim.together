--- /dev/null
+++ b/Code/client/Services/Generic/ProgressConsent.cpp
@@ -0,0 +1,101 @@
+#include <TiltedOnlinePCH.h>
+#include <World.h>
+#include <OverlayApp.hpp>
+#include <Services/OverlayClient.h>
+#include <Services/OverlayService.h>
+#include <PlayerCharacter.h>

+bool PartyService::WithinSyncRange(World& world, Player& a, Player& b) noexcept
+{
+    if (!a.GetCharacter() || !b.GetCharacter())
+        return false;
+    const auto& x = a.GetCellComponent();
+    const auto& y = b.GetCellComponent();
+    if (x.WorldSpaceId != y.WorldSpaceId || (!x.WorldSpaceId && (!x.Cell || x.Cell != y.Cell)))
+        return false;
+    const auto* first = world.try_get<MovementComponent>(*a.GetCharacter());
+    const auto* second = world.try_get<MovementComponent>(*b.GetCharacter());
+    return first && second && glm::distance(first->Position, second->Position) <= 1200.f;
+}
+
 void PartyService::OnUpdate(const UpdateEvent& acEvent) noexcept
 {
     const auto cCurrentTick = GameServer::Get()->GetTick();
+    if (cCurrentTick >= m_rangeTick)
+    {
+        m_rangeTick = cCurrentTick + 250;
+        std::map<std::pair<uint32_t,uint32_t>,bool> current;
+        for (auto& entry : m_parties)
+        {
+            const auto& members = entry.second.Members;
+            for (size_t i = 0; i < members.size(); ++i)
+                for (size_t j = i + 1; j < members.size(); ++j)
+                {
+                    auto* a = members[i];
+                    auto* b = members[j];
+                    const std::pair<uint32_t,uint32_t> key{std::min(a->GetId(), b->GetId()), std::max(a->GetId(), b->GetId())};
+                    bool withinRange = WithinSyncRange(m_world, *a, *b);
+                    current[key] = withinRange;
+                    auto old = m_peerRange.find(key);
+                    if (old != m_peerRange.end() && old->second == withinRange)
+                        continue;
+                    NotifyCoopInteraction message;
+                    message.Event = {Interaction::SyncRange, b->GetId(), 0, withinRange ? 1u : 0u, {}};
+                    a->Send(message);
+                    message.Event.Speaker = a->GetId();
+                    b->Send(message);
+                }
+        }
+        m_peerRange.swap(current);
+    }
     if (m_nextInvitationExpire > cCurrentTick)
         return;
 

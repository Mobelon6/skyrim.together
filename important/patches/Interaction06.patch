diff --git a/Code/client/Services/Generic/PartyHome.cpp b/Code/client/Services/Generic/PartyHome.cpp
new file mode 100644
index 0000000..79a30ea
--- /dev/null
+++ b/Code/client/Services/Generic/PartyHome.cpp
@@ -0,0 +1,231 @@
+#include <TiltedOnlinePCH.h>
+#include <World.h>
+#include <Services/HomeInstance.h>
+#include <Services/OverlayClient.h>
+#include <Services/OverlayService.h>
+#include <Services/PapyrusService.h>
+#include <OverlayApp.hpp>
+#include <PlayerCharacter.h>
+#include <Games/TES.h>
+#include <Forms/TESFaction.h>
+#include <Forms/TESNPC.h>
+#include <Forms/TESObjectCELL.h>
+#include <Messages/NotifyPartyHome.h>
+#include <Messages/RequestPartyHome.h>
+#include <Interface/UI.h>
+#include <atomic>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <map>
+
+namespace
+{
+using Clock=std::chrono::steady_clock;
+using namespace std::chrono_literals;
+struct Ref {uint32_t original, copy;};
+struct House {uint32_t slot{},original{},copy{}; std::vector<Ref> refs;std::string visible;bool owned{};};
+struct Door {uint32_t slot; glm::vec3 pos,rotation;};
+struct Advert {std::string visible; Clock::time_point until;};
+std::map<uint32_t,House> houses;
+std::map<uint32_t,Door> doors;
+std::map<std::pair<uint32_t,uint32_t>,Advert> ads;
+uint32_t door{}, token{}, guestSlot{}, guestOwner{};
+std::vector<uint32_t> options;
+Clock::time_point refresh{}, applyAt{};
+std::string applied;
+bool selection{}, initialized{};
+struct Route {uint32_t source{},copy{},slot{};std::atomic_uint32_t own{},visit{};};
+Route routes[5];
+std::atomic_uint32_t routeCount{},self{UINT32_MAX};
+constexpr uint32_t invalid=UINT32_MAX;
+
+bool Init()
+{
+    if (initialized) return !houses.empty();
+    auto* mods=ModManager::Get();
+    if (!mods) return false;
+    auto* p=mods->GetByName("SkyrimCoopGuestHomes.esp");
+    if (!p || !p->IsLoaded()) {initialized=true;return false;}
+    std::ifstream f(std::filesystem::path("Data")/"SkyrimTogetherReborn"/"config"/"CoopHomes.txt");
+    if (!f) return false;
+    char kind{};uint32_t original{},slot{},copy{};std::string mod;
+    while (f>>kind)
+    {
+        if (kind=='H' && (f>>original>>slot))
+        {
+            auto& h=houses[slot];h.slot=slot;h.original=original;h.copy=p->GetFormId(slot);
+        }
+        else if (kind=='R' && (f>>std::quoted(mod)>>original>>copy>>slot))
+        {
+            auto* m=mods->GetByName(mod.c_str());
+            houses[slot].refs.push_back({m && m->IsLoaded()?m->GetFormId(original):0,p->GetFormId(copy)});
+        }
+        else if (kind=='D' && (f>>std::quoted(mod)>>original>>slot))
+        {
+            Door d{slot};f>>d.pos.x>>d.pos.y>>d.pos.z>>d.rotation.x>>d.rotation.y>>d.rotation.z;
+            if (auto* m=mods->GetByName(mod.c_str());m && m->IsLoaded()) doors[m->GetFormId(original)]=d;
+        }
+        else {houses.clear();break;}
+    }
+    initialized=true;
+    if (!f.eof() || houses.empty() || houses.size()>std::size(routes)) {houses.clear();return false;}
+    uint32_t i=0;
+    for (const auto& [id,h]:houses)
+    {
+        auto& r=routes[i++];r.source=h.original;r.copy=h.copy;r.slot=id;
+    }
+    routeCount.store(i);return true;
+}
+bool Owned(World& w,TESObjectCELL* cell,PlayerCharacter* p)
+{
+    if (!cell || !p) return false;
+    auto& vm=w.ctx().at<PapyrusService>();
+    auto* a=vm.Get("Cell","GetActorOwner");
+    auto* f=vm.Get("Cell","GetFactionOwner");
+    if (a && PapyrusFunction<TESNPC*,TESObjectCELL>(a)(cell)==p->baseForm) return true;
+    if (!f) return false;
+    auto* faction=PapyrusFunction<TESFaction*,TESObjectCELL>(f)(cell);
+    return faction && faction->formID==0xDB1; // PlayerFaction, assigned by the purchase fragment
+}
+void SetVisit(uint32_t slot,uint32_t owner)
+{
+    for (unsigned i=0;i<routeCount.load();++i) routes[i].visit.store(routes[i].slot==slot ? owner+1 : 0);
+    guestSlot=slot;guestOwner=owner;applied.clear();applyAt={};
+}
+}
+namespace HomeInstance
+{
+bool Tagged(uint32_t mod) noexcept {return (mod&0xFFFF0000u)==0xFFFE0000u;}
+bool Foreign(uint32_t mod) noexcept {return Tagged(mod) && (mod&0xffff)!=self.load();}
+bool Encode(uint32_t local,uint32_t& mod,uint32_t& base) noexcept
+{
+    for (uint32_t i=0;i<routeCount.load();++i)
+    {
+        const auto& r=routes[i];
+        uint32_t who=local==r.source?r.own.load():local==r.copy?r.visit.load():0;
+        if (who && who<=65535) {mod=0xFFFE0000u | (who-1);base=r.slot;return true;}
+    }
+    return false;
+}
+uint32_t Decode(uint32_t mod,uint32_t base) noexcept
+{
+    uint32_t who=(mod&0xffff)+1;
+    for (uint32_t i=0;i<routeCount.load();++i)
+        if (routes[i].slot==base)
+        {
+            if (routes[i].own.load()==who) return routes[i].source;
+            if (routes[i].visit.load()==who) return routes[i].copy;
+        }
+    return 0;
+}
+bool PrivateCell(uint32_t local) noexcept
+{
+    for (uint32_t i=0;i<routeCount.load();++i)
+        if (local==routes[i].copy || (local==routes[i].source && routes[i].own.load())) return true;
+    return false;
+}
+}
+void OverlayService::ClearHomes() noexcept
+{
+    if (selection && m_pOverlay && m_gameOverlayClient)
+    {m_pOverlay->ExecuteAsync("hideHome");m_gameOverlayClient->SetUIVisible(false);}
+    selection=false;door=0;options.clear();ads.clear();SetVisit(0,0);refresh={};self.store(invalid);
+    for (unsigned i=0;i<routeCount.load();++i) routes[i].own.store(0);
+    for (auto& [_,h]:houses){h.owned=false;h.visible.clear();}
+}
+void OverlayService::OnHome(const NotifyPartyHome& msg) noexcept
+{
+    if (!Init()) return;
+    const auto& e=msg.Event;
+    const auto& members=m_world.GetPartyService().GetPartyMembers();
+    if (!houses.count(e.House) || std::find(members.begin(),members.end(),e.Owner)==members.end() ||
+        (!e.Visible.empty() && e.Visible.size()!=houses.at(e.House).refs.size())) return;
+    auto& a=ads[{e.House,e.Owner}];a.visible.assign(e.Visible.begin(),e.Visible.end());a.until=Clock::now()+12s;
+}
+bool OverlayService::TryHouseDoor(uint32_t form) noexcept
+{
+    if (!m_world.GetPartyService().IsInParty() || !m_inGame || m_active || !m_pOverlay || !m_gameOverlayClient ||
+        !doors.count(form) || selection) return false;
+    const auto slot=doors.at(form).slot;
+    if (!houses[slot].owned) return false;
+    options.clear();std::string labels;
+    const auto& players=m_world.GetPartyService().GetPlayers();
+    for (const auto& [key,a]:ads)
+        if (key.first==slot && a.until>Clock::now() && players.count(key.second))
+        {
+            auto name=players.at(key.second);
+            for(char& c:name) if (c=='\n' || c=='\r') c=' ';
+            if (!options.empty()) labels+='\n';
+            labels+=name.c_str();options.push_back(key.second);
+        }
+    if (options.empty()) return false;
+    selection=true;door=form;if (!++token) ++token;
+    auto args=CefListValue::Create();args->SetInt(0,token);args->SetString(1,labels);
+    m_pOverlay->ExecuteAsync("offerHome",args);m_gameOverlayClient->SetUIVisible(true);return true;
+}
+void OverlayService::ChooseHome(uint32_t nonce,int choice) noexcept
+{
+    if (!selection || nonce!=token) return;
+    selection=false;m_pOverlay->ExecuteAsync("hideHome");m_gameOverlayClient->SetUIVisible(false);
+    auto* player=PlayerCharacter::Get();
+    auto* entrance=Cast<TESObjectREFR>(TESForm::GetById(door));
+    if (!player || !entrance || choice<0 || !doors.count(door) ||
+        player->GetParentCellEx()!=entrance->GetParentCellEx() ||
+        glm::distance(static_cast<const glm::vec3&>(player->position),static_cast<const glm::vec3&>(entrance->position))>350.f) return;
+    if (!choice) {entrance->Activate(player,0,nullptr,1,0);return;}
+    if (static_cast<size_t>(choice)>options.size()) return;
+    const auto& d=doors.at(door);auto owner=options[choice-1];auto a=ads.find({d.slot,owner});
+    if (a==ads.end() || Clock::now()>=a->second.until) return;
+    auto* copy=Cast<TESObjectCELL>(TESForm::GetById(houses.at(d.slot).copy));
+    if (!copy) return;
+    SetVisit(d.slot,owner);player->SetRotation(d.rotation.x,d.rotation.y,d.rotation.z);
+    player->MoveTo(copy,d.pos);
+}
+void OverlayService::UpdateHomes() noexcept
+{
+    if (!m_transport.IsConnected() || !m_world.GetPartyService().IsInParty() || !m_inGame) return;
+    auto* p=PlayerCharacter::Get();
+    if (!p || !p->parentCell || !Init()) return;
+    if (selection && !GetActive()) {selection=false;m_pOverlay->ExecuteAsync("hideHome");}
+    auto* current=p->GetParentCellEx();
+    const auto now=Clock::now();
+    if (now>=refresh)
+    {
+        refresh=now+3s;
+        const auto id=m_transport.GetLocalPlayerId();self.store(id);
+        unsigned i=0;
+        for (auto& [slot,h]:houses)
+        {
+            auto* cell=Cast<TESObjectCELL>(TESForm::GetById(h.original));
+            h.owned=Owned(m_world,cell,p);routes[i++].own.store(h.owned?id+1:0);
+            if (!h.owned) continue;
+            if (cell==current && cell->IsAttached())
+            {
+                h.visible.clear();h.visible.reserve(h.refs.size());
+                for (const auto& entry:h.refs)
+                {
+                    auto* ref=entry.original?Cast<TESObjectREFR>(TESForm::GetById(entry.original)):nullptr;
+                    h.visible+=ref?(ref->IsDisabled()?'0':'1'):'?';
+                }
+            }
+            RequestPartyHome m;m.Event.House=slot;m.Event.Visible=h.visible.c_str();m_transport.Send(m);
+        }
+    }
+    if (!guestSlot || !current || current->formID!=houses.at(guestSlot).copy || !current->IsAttached() || now<applyAt) return;
+    applyAt=now+1s;
+    auto a=ads.find({guestSlot,guestOwner});if (a==ads.end()) return;
+    auto& h=houses.at(guestSlot);
+    const auto& visible=a->second.visible;
+    if (visible.size()!=h.refs.size()) return;
+    if (applied.size()!=visible.size()) applied.assign(visible.size(),'?');
+    for (size_t i=0;i<visible.size();++i)
+    {
+        if (visible[i]=='?' || visible[i]==applied[i]) continue;
+        auto* ref=Cast<TESObjectREFR>(TESForm::GetById(h.refs[i].copy));
+        if (!ref) continue;
+        if (visible[i]=='1' && ref->IsDisabled()) ref->Enable();
+        if (visible[i]=='0' && !ref->IsDisabled()) ref->Disable();
+        applied[i]=visible[i];
+    }
+}
diff --git a/Code/client/Services/Generic/PartyTrade.cpp b/Code/client/Services/Generic/PartyTrade.cpp
new file mode 100644
index 0000000..baada80
--- /dev/null
+++ b/Code/client/Services/Generic/PartyTrade.cpp
@@ -0,0 +1,215 @@
+#include <TiltedOnlinePCH.h>
+#include <World.h>
+#include <Services/OverlayService.h>
+#include <Services/OverlayClient.h>
+#include <Services/PapyrusService.h>
+#include <Services/PartyService.h>
+#include <OverlayApp.hpp>
+#include <include/cef_parser.h>
+#include <Messages/RequestPartyTrade.h>
+#include <Messages/NotifyPartyTrade.h>
+#include <PlayerCharacter.h>
+#include <Forms/TESGlobal.h>
+#include <Games/TES.h>
+#include <ExtraData/ExtraContainerChanges.h>
+#include <Games/ActorExtension.h>
+#include <Utils.h>
+#include <Interface/UI.h>
+#include <map>
+#include <set>
+
+namespace
+{
+using Clock=std::chrono::steady_clock;
+using namespace std::chrono_literals;
+struct Wallet
+{
+    TESGlobal* fields[4]{};
+    const void* setter{};
+    bool Load(World& world)
+    {
+        auto* plugin=ModManager::Get()->GetByName("SkyrimCoopTrade.esp");
+        if (!plugin || !plugin->IsLoaded()) return false;
+        for (unsigned i=0;i<4;++i)
+        {
+            auto* f=TESForm::GetById(plugin->GetFormId(0x800+i));
+            if (!f || static_cast<unsigned>(f->formType)!=9) return false;
+            fields[i]=static_cast<TESGlobal*>(f);
+        }
+        setter=world.ctx().at<PapyrusService>().Get("GlobalVariable","SetValue");
+        return setter!=nullptr;
+    }
+    uint64_t Stream() const {return uint64_t(fields[0]->f) | (uint64_t(fields[1]->f)<<22) | (uint64_t(fields[2]->f)<<44);}
+    uint32_t Cursor() const {return static_cast<uint32_t>(fields[3]->f);}
+    void Write(uint64_t stream, uint32_t cursor)
+    {
+        PapyrusFunction<void,TESGlobal,float> set(setter);
+        if (!Stream()) for (unsigned i=0;i<3;++i) set(fields[i],float((stream>>(22*i))&0x3FFFFF));
+        set(fields[3],float(cursor));
+    }
+};
+uint32_t session{},peer{};
+bool tradeOpen{}, ownsUI{}, dirty{};
+std::string partner;
+Clock::time_point pollAt{};
+std::map<uint32_t,int> buffer;
+void Send(PartyTrade e)
+{
+    RequestPartyTrade m; m.Event=std::move(e); World::Get().GetTransport().Send(m);
+}
+std::set<uint32_t> Unsuitable(PlayerCharacter& p)
+{
+    std::set<uint32_t> bad;
+    auto* changes=p.GetContainerChanges();
+    if (!changes || !changes->entries) return bad;
+    for (auto* e:*changes->entries)
+    {
+        if (!e || !e->form) continue;
+        if (e->IsQuestObject()) {bad.insert(e->form->formID);continue;}
+        if (!e->dataList) continue;
+        for (auto* list:*e->dataList)
+        {
+            if (!list) continue;
+            list->lock.LockForRead();
+            bool special=false;
+            for (auto* x=list->data;x;x=x->next)
+                if (x->GetType()!=ExtraDataType::Count) {special=true;break;}
+            list->lock.UnlockRead();
+            if (special) {bad.insert(e->form->formID);break;}
+        }
+    }
+    return bad;
+}
+std::map<uint32_t,int> Pocket(World& world, PlayerCharacter& p)
+{
+    std::map<uint32_t,int> items;
+    const auto bad=Unsuitable(p);
+    for (const auto& e:p.GetInventory().Entries)
+    {
+        const auto id=world.GetModSystem().GetGameId(e.BaseId);
+        if (id && (id>>24)!=0xFF && e.Count>0 && !e.ContainsExtraData() && !bad.count(id))
+            items[id]+=e.Count;
+    }
+    return items;
+}
+CefString Rows(const std::map<uint32_t,int>& items)
+{
+    auto list=CefListValue::Create();
+    for (const auto& [id,count]:items)
+    {
+        auto* f=TESForm::GetById(id);
+        const char* label=f?f->GetName():nullptr;
+        if (!label || !*label || count<=0) continue;
+        auto row=CefDictionaryValue::Create();
+        row->SetDouble("id",id); row->SetString("name",label); row->SetInt("count",count);
+        list->SetDictionary(list->GetSize(),row);
+    }
+    auto value=CefValue::Create(); value->SetList(list); return CefWriteJSON(value,JSON_WRITER_DEFAULT);
+}
+}
+
+uint32_t OverlayService::TradePeer(uint32_t form) const noexcept
+{
+    if (!form || !m_world.GetPartyService().IsInParty()) return UINT32_MAX;
+    auto view=m_world.view<PlayerComponent,FormIdComponent>();
+    const auto& members=m_world.GetPartyService().GetPartyMembers();
+    for (auto e:view)
+        if (view.get<FormIdComponent>(e).Id==form)
+        {
+            const auto id=view.get<PlayerComponent>(e).Id;
+            if (id!=m_transport.GetLocalPlayerId() && std::find(members.begin(),members.end(),id)!=members.end()) return id;
+        }
+    return UINT32_MAX;
+}
+bool OverlayService::TryTrade(uint32_t form) noexcept
+{
+    const auto id=TradePeer(form);
+    if (id==UINT32_MAX) return false;
+    Wallet w;
+    if (!w.Load(m_world)) Utils::ShowHudMessage("Для обмена включите SkyrimCoopTrade.esp.");
+    else if (!session && !m_active) Send({TradeOp::Invite,id,0,w.Cursor(),0,w.Stream()});
+    return true;
+}
+void OverlayService::ClearTrade() noexcept
+{
+    if (session && m_pOverlay) m_pOverlay->ExecuteAsync("hideTrade");
+    if (ownsUI && m_gameOverlayClient && GetActive()) m_gameOverlayClient->SetUIVisible(false);
+    session=peer=0; tradeOpen=ownsUI=dirty=false; buffer.clear(); partner.clear(); pollAt={};
+}
+void OverlayService::TradeAction(uint32_t token,int action,uint32_t id,uint32_t count) noexcept
+{
+    if (!session || session!=token) return;
+    Wallet w;
+    if (action==0) {Send({TradeOp::Close,peer,session}); ClearTrade();return;}
+    if (!w.Load(m_world)) return;
+    PartyTrade e{TradeOp::Accept,peer,session,w.Cursor(),count,w.Stream()};
+    if (action==1 && !tradeOpen) {Send(e);return;}
+    if (!tradeOpen || (action!=2 && action!=3) || !count || count>9999) return;
+    auto* p=PlayerCharacter::Get(); if (!p) return;
+    if (action==2 && Pocket(m_world,*p)[id]<static_cast<int>(count)) return;
+    if (action==3 && (!buffer.count(id) || buffer[id]<static_cast<int>(count))) return;
+    if (!m_world.GetModSystem().GetServerModId(id,e.Item)) return;
+    e.Op=action==2?TradeOp::Deposit:TradeOp::Take; Send(e);
+}
+void OverlayService::OnTrade(const NotifyPartyTrade& msg) noexcept
+{
+    auto* p=PlayerCharacter::Get();
+    if (!m_inGame || !p || !p->parentCell || !m_pOverlay || !m_gameOverlayClient) return;
+    const auto& e=msg.Event;
+    Wallet w; if (!w.Load(m_world)) return;
+    if (e.Stream && w.Stream() && w.Stream()!=e.Stream) {Utils::ShowHudMessage("Обмен привязан к другому журналу сервера.");return;}
+    if (e.Op==TradeOp::Receipt)
+    {
+        if (!e.Stream || e.Cursor!=w.Cursor()+1 || !e.Count || e.Count>9999 || !e.Item.BaseId || p->IsDead() || !p->GetNiNode()) return;
+        auto* mod=ModManager::Get()->GetByName(e.Text.c_str());
+        if (!mod || !mod->IsLoaded()) return;
+        const auto id=mod->GetFormId(e.Item.BaseId);
+        auto* form=TESForm::GetById(id);
+        if (!form || !Cast<TESBoundObject>(form)) return;
+        const int count=(e.Peer?1:-1)*int(e.Count);
+        if (count<0 && Pocket(m_world,*p)[id]<-count) return;
+        Inventory::Entry item{};
+        if (!m_world.GetModSystem().GetServerModId(id,item.BaseId)) return;
+        const auto before=p->GetItemCountInInventory(form);
+        item.Count=count; p->AddOrRemoveItem(item,true);
+        if (p->GetItemCountInInventory(form)!=before+count) {spdlog::error("Unexpected inventory count applying trade receipt {}",e.Cursor);return;}
+        w.Write(e.Stream,e.Cursor); pollAt={}; return;
+    }
+    if (e.Op==TradeOp::Error) {Utils::ShowHudMessage("Сервер не подтвердил операцию обмена.");return;}
+    if (e.Op==TradeOp::Offer || e.Op==TradeOp::Open)
+    {
+        if ((session && session!=e.Session) || !m_world.GetPartyService().IsInParty() || m_promptOpen || m_showingProgress || m_observerCamera || (GetActive() && !ownsUI))
+        {Send({TradeOp::Close,e.Peer,e.Session});return;}
+        session=e.Session;peer=e.Peer;partner=e.Text.c_str();tradeOpen=e.Op==TradeOp::Open;
+        ownsUI=true; m_gameOverlayClient->SetUIVisible(true);
+    }
+    else if (!session || e.Session!=session) return;
+    else if (e.Op==TradeOp::Close) {ClearTrade();return;}
+    else if (e.Op==TradeOp::Reset) buffer.clear();
+    else if (e.Op==TradeOp::Entry)
+    {
+        auto* mod=ModManager::Get()->GetByName(e.Text.c_str());
+        if (mod && mod->IsLoaded()) buffer[mod->GetFormId(e.Item.BaseId)]=int(e.Count);
+    }
+    dirty=true;
+}
+void OverlayService::UpdateTrade() noexcept
+{
+    if (!m_transport.IsConnected() || !m_inGame || !PlayerCharacter::Get() || !PlayerCharacter::Get()->GetNiNode()) return;
+    if (session && (!GetActive() || !m_world.GetPartyService().IsInParty()))
+    {Send({TradeOp::Close,peer,session});ClearTrade();}
+    if (session && dirty && m_pOverlay)
+    {
+        dirty=false;
+        auto* p=PlayerCharacter::Get();
+        auto args=CefListValue::Create();
+        args->SetInt(0,session); args->SetString(1,partner);args->SetBool(2,tradeOpen);
+        args->SetString(3,tradeOpen?Rows(Pocket(m_world,*p)):CefString("[]"));args->SetString(4,Rows(buffer));
+        m_pOverlay->ExecuteAsync("partyTrade",args);
+    }
+    const auto now=Clock::now();
+    if (now<pollAt) return;
+    pollAt=now+(session?1s:5s);
+    Wallet w;
+    if (w.Load(m_world)) Send({TradeOp::Poll,peer,session,w.Cursor(),0,w.Stream()});
+}

+            for (auto& n:e.Pose)
+                if (!(row>>n) || !std::isfinite(std::bit_cast<float>(n))) return {};
+            if (row>>extra || std::none_of(c.Refs.begin(),c.Refs.end(),
+                [&](const Ref& r){return r.Target.Local==id;})) return {};
+            c.Entrances.push_back(std::move(e));
+        }
+        else return {};
+    }

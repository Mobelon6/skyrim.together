+            auto bytes=CampaignAccess::HomeBaseline(identity->Save.Campaign,slot);
+            auto state=bytes?HomeSnapshot::Decode(*bytes):std::nullopt;
+            if (!state || !HomeCatalog::Bind(*cell,*state)) continue;
+            if (!labels.empty()) labels+='\n';
+            labels+="персонажу "+std::to_string(owner);
+            campaignOptions.push_back({slot,owner,cell->Root.Encode()});
+        }

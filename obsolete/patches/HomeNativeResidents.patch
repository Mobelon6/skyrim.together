+inline const std::optional<std::set<Row>>& Loaded()
+{
+    static const auto rows=[]()
+    {
+        std::ifstream f(std::filesystem::path("Data")/"SkyrimTogetherReborn"/"config"/"CoopNativeHomeObjects.txt");
+        return Read(f);
+    }();
+    return rows;
+}
+inline bool Allows(char tag,const std::string& root,const std::string& ref,const std::string& base)
+{
+    try {const auto& rows=Loaded();return rows&&rows->count({tag,root,ref,base});}
+    catch (...) {return false;}
+}
+inline std::map<std::string,TradeProperties::FormKey> Residents(const std::string& root)
+{
+    std::map<std::string,TradeProperties::FormKey> result;
+    const auto& rows=Loaded();
+    if (rows)
+        for (const auto& [tag,cell,ref,base]:*rows)
+            if (tag=='A'&&cell==root)
+                if (auto key=TradeProperties::DecodeForm(base)) result.emplace(ref,*key);
+    return result;
+}
+inline bool Covers(const std::map<std::string,TradeProperties::FormKey>& bases,
+    const HomeSnapshot::State& state,const HomeResidents::Residents& records)
+{
+    if (state.ResidentKeys.size()!=bases.size()||records.size()!=bases.size()||
+        bases.size()>HomeResidents::MaxResidents) return false;
+    for (const auto& [key,base]:bases)
+    {
+        const auto it=records.find(key);
+        if (!state.ResidentKeys.count(key)||it==records.end()||!it->second.Revision||
+            !it->second.Value.Valid()||it->second.Value.Reference.Encode()!=key||
+            it->second.Value.Base.Encode()!=base.Encode()||
+            (it->second.Value.Flags&2u)) return false;
+    }
+    return true;
+}
 }

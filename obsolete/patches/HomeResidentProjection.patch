diff --git a/Code/common/HomeResidentPlan.h b/Code/common/HomeResidentPlan.h
new file mode 100644
--- /dev/null
+++ b/Code/common/HomeResidentPlan.h
@@ -0,0 +1,21 @@
+#pragma once
+#include "HomeCatalog.h"
+#include "HomeResidents.h"
+
+namespace HomeResidentPlan
+{
+// Only explicit catalog bindings and a committed coverage set can authorize
+// restoration. Old omitted counts and unknown ACHR are never reinterpreted.
+inline std::optional<HomeResidents::Residents> Build(const HomeCatalog::Cell& cell,
+    const HomeSnapshot::State& baseline,const HomeResidents::Residents& records)
+{
+    if (!HomeCatalog::Bind(cell,baseline) || records.size()!=cell.ResidentBases.size()) return {};
+    for (const auto& [key,base]:cell.ResidentBases)
+    {
+        const auto it=records.find(key);
+        if (it==records.end() || !it->second.Revision || !it->second.Value.Valid() ||
+            it->second.Value.Reference.Encode()!=key || it->second.Value.Base.Encode()!=base.Encode()) return {};
+    }
+    return records;
+}
+}

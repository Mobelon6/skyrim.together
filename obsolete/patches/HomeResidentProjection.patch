+bool HomeResidentProjection::Sync(World& world,TESObjectCELL& cell,uint32_t slot,const std::vector<Entry>& entries)
+{
+    if (!slot || !HomeInstance::ProjectionForm(cell.formID) || !cell.IsAttached()) return false;
+    if (residentSlot!=slot || residentCell!=cell.formID)
+    {Clear();residentSlot=slot;residentCell=cell.formID;}
+    std::set<uint32_t> seen;
+    for (const auto& e:entries)
+    {
+        GameId reference{};
+        if (!e.Source || !e.Base || !seen.insert(e.Source).second ||
+            !world.GetModSystem().GetServerModId(e.Source,reference) ||
+            !e.Record.Value.Valid()) return false;
+        auto* npc=Cast<TESNPC>(TESForm::GetById(e.Base));
+        if (!npc || npc->IsTemporary()) return false;
+        const auto& s=e.Record.Value;
+        // Live network state wins while it exists. Otherwise show the last
+        // committed observation, never the visitor's original reference.
+        if (LiveResident(world,slot,reference) || (s.Flags&5u))
+        {DropResidentDisplay(e.Source);continue;}
+        auto it=residentDisplays.find(e.Source);
+        auto* actor=it==residentDisplays.end()?nullptr:DisplayActor(it->second);
+        if (actor && actor->GetParentCellEx()==&cell && it->second.Revision==e.Record.Revision) continue;
+        if (actor && actor->GetParentCellEx()!=&cell)
+        {DropResidentDisplay(e.Source);actor=nullptr;}
+        if (!actor)
+        {
+            DropResidentDisplay(e.Source);
+            actor=Actor::Create(npc);
+            if (!actor) return false;
+            if (!actor->IsTemporary() || !actor->GetExtension() ||
+                !actor->GetExtension()->IsRemote() || actor->GetExtension()->IsPlayer()) return false;
+            const auto handle=actor->GetHandle().handle.iBits;
+            if (!handle || actor->baseForm!=npc || actor->scale!=s.Scale)
+            {actor->Disable();actor->Delete();return false;}
+            residentDisplays.emplace(e.Source,ResidentDisplay{actor->formID,e.Base,cell.formID,0,handle});
+        }
+        if (actor->baseForm!=npc || actor->scale!=s.Scale)
+        {DropResidentDisplay(e.Source);return false;}
+        const auto v=[&](size_t n){return std::bit_cast<float>(s.Transform[n]);};
+        actor->SetRotation(v(3),v(4),v(5));
+        actor->MoveTo(&cell,glm::vec3{v(0),v(1),v(2)});
+        if (actor->GetParentCellEx()!=&cell) {DropResidentDisplay(e.Source);return false;}
+        const bool dead=(s.Flags&2u)!=0;
+        if (actor->IsDead()!=dead)
+        {
+            if (dead) actor->Kill();
+            else actor->RestoreRemoteLife();
+        }
+        if (actor->IsDead()!=dead) {DropResidentDisplay(e.Source);return false;}
+        residentDisplays.at(e.Source).Revision=e.Record.Revision;
+    }
+    for (auto it=residentDisplays.begin();it!=residentDisplays.end();)
+    {
+        const auto source=it++->first;
+        if (!seen.count(source)) DropResidentDisplay(source);
+    }
+    return true;
+}

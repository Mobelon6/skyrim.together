diff --git a/Code/common/HomePermissions.h b/Code/common/HomePermissions.h
new file mode 100644
--- /dev/null
+++ b/Code/common/HomePermissions.h
@@ -0,0 +1,82 @@
+#pragma once
+#include "HomeRegistry.h"
+#include <map>
+#include <sstream>
+#include <string>
+#include <utility>
+
+namespace HomePermissions
+{
+enum class Right : uint32_t { None, Visit, Modify };
+struct Change
+{
+    uint32_t Slot{};
+    uint64_t Owner{}, Guest{};
+    Right Access{};
+};
+inline std::string Encode(const Change& c)
+{
+    return std::to_string(c.Slot)+" "+std::to_string(c.Owner)+" "+
+        std::to_string(c.Guest)+" "+std::to_string(static_cast<uint32_t>(c.Access));
+}
+inline std::optional<Change> Decode(std::string_view bytes)
+{
+    Change c;uint32_t right{};std::string extra;
+    std::istringstream in{std::string(bytes)};
+    if (!(in>>c.Slot>>c.Owner>>c.Guest>>right) || in>>extra ||
+        !c.Slot || !c.Owner || !c.Guest || c.Owner==c.Guest || right>2) return {};
+    c.Access=static_cast<Right>(right);
+    if (Encode(c)!=bytes) return {};
+    return c;
+}
+struct Rules
+{
+    std::map<std::pair<uint32_t,uint64_t>,Right> Guests;
+    uint32_t Revision{};
+};
+inline std::optional<Rules> Read(const CampaignJournal::Journal& journal)
+{
+    auto homes=HomeRegistry::Read(journal);
+    if (!homes) return {};
+    Rules out;
+    for (const auto& row:journal.Operations())
+    {
+        if (row.Kind!="home-access-v1") continue;
+        const auto c=Decode(row.Payload);
+        if (!c || c->Slot>homes->size() || (*homes)[c->Slot-1].Owner!=c->Owner ||
+            out.Revision==UINT32_MAX || row.Id!="home-access-"+std::to_string(out.Revision+1)) return {};
+        auto key=std::pair{c->Slot,c->Guest};
+        const auto prior=out.Guests.find(key);
+        const auto right=prior==out.Guests.end()?Right::None:prior->second;
+        if (right==c->Access) return {};
+        if (c->Access==Right::None) out.Guests.erase(key);
+        else out.Guests[key]=c->Access;
+        ++out.Revision;
+    }
+    return out;
+}
+inline Right Effective(const CampaignJournal::Journal& journal,uint32_t slot,uint64_t character)
+{
+    if (!character) return Right::None;
+    auto home=HomeRegistry::BySlot(journal,slot);
+    auto rules=Read(journal);
+    if (!home || !rules) return Right::None;
+    if (home->Owner==character) return Right::Modify;
+    const auto it=rules->Guests.find({slot,character});
+    return it==rules->Guests.end()?Right::None:it->second;
+}
+inline bool Set(CampaignJournal::Journal& journal,uint64_t actor,uint32_t slot,
+                uint64_t guest,Right right,uint32_t expected)
+{
+    auto home=HomeRegistry::BySlot(journal,slot);
+    auto rules=Read(journal);
+    if (!home || !rules || !actor || actor!=home->Owner || !guest || guest==actor ||
+        static_cast<uint32_t>(right)>2 || rules->Revision!=expected) return false;
+    const auto it=rules->Guests.find({slot,guest});
+    const auto prior=it==rules->Guests.end()?Right::None:it->second;
+    if (prior==right) return true;
+    if (rules->Revision==UINT32_MAX) return false;
+    return journal.Append(journal.Current(),{"home-access-"+std::to_string(rules->Revision+1),
+        "home-access-v1",Encode({slot,actor,guest,right})})==CampaignJournal::Result::Committed;
+}
+}
diff --git a/Code/common/HomeProjectionPlan.h b/Code/common/HomeProjectionPlan.h
new file mode 100644
--- /dev/null
+++ b/Code/common/HomeProjectionPlan.h
@@ -0,0 +1,45 @@
+#pragma once
+#include "HomeSnapshot.h"
+#include <map>
+#include <set>
+#include <vector>
+
+namespace HomeProjection
+{
+struct Binding
+{
+    TradeProperties::FormKey Source,Target,TargetBase;
+    uint32_t Type{};
+};
+struct Step
+{
+    const HomeSnapshot::Ref* State{};
+    Binding Destination;
+};
+inline std::optional<std::vector<Step>> Plan(const HomeSnapshot::State& state,
+    const std::vector<Binding>& bindings,std::string_view isolatedPlugin)
+{
+    if (!state.Valid() || state.Omitted || bindings.size()!=state.Refs.size() ||
+        isolatedPlugin.empty()) return {};
+    std::map<std::string,Binding> bySource;
+    std::set<std::string> targets;
+    for (const auto& b:bindings)
+    {
+        if (!b.Source.Valid() || !b.Target.Valid() || !b.TargetBase.Valid() ||
+            b.Target.Plugin!=isolatedPlugin || b.Source.Plugin==isolatedPlugin ||
+            !targets.insert(b.Target.Encode()).second ||
+            !bySource.emplace(b.Source.Encode(),b).second) return {};
+    }
+    std::vector<Step> result;
+    for (const auto& row:state.Refs)
+    {
+        auto it=bySource.find(row.Key.Encode());
+        if (it==bySource.end() || row.Type!=it->second.Type ||
+            row.Inventory==2 || (row.Flags&2)) return {};
+        // Source deletion is not reproduced by destroying a reusable shell.
+        // Missing/unsupported inventory is never interpreted as empty.
+        result.push_back({&row,it->second});
+    }
+    return result;
+}
+}

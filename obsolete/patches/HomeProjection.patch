+        if (!e.Campaign || !e.Character || !e.House || e.House>HomeRegistry::MaxSlot ||
+            e.Owner!=m_transport.GetLocalPlayerId() || !e.Visible.empty() ||
+            !e.Profile.empty() || !e.Credential.empty() || e.Root.size()>220) return;

+    e.Root=track.Plot.c_str();e.AccessOp=9;e.AccessRevision=track.Revision;e.SnapshotDigest=binding;e.Visible=bits.c_str();
+    if (world.GetTransport().Send(request)) {track.Pending=bits;track.Next=now+3s;}
+}
+}

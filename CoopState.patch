-        Entries.push_back(acEntry);
+        if (!it->CanBeMerged(acEntry))
+        {
+            ++it;
+            continue;
+        }
+
+        const auto take = (std::min)(remaining, int64_t{(std::max)(int32_t{0}, it->Count)});
+        remaining -= take;
+        it->Count -= static_cast<int32_t>(take);
+        if (it->Count <= 0)
+            it = Entries.erase(it);
+        else
+            ++it;
     }
 }
 

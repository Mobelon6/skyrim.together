+        !object.baseForm || object.baseForm->IsTemporary() || Cast<Actor>(&object) ||
+        !HomeSnapshot::LooseType(static_cast<uint32_t>(object.baseForm->formType)) ||
+        NativeTrade::IsProxy(&object) || Tracked(&object)) return {};

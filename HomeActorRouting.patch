+// Use a static base supplied by the owner, never the visitor's placed actor.
+// Actor::Create marks the new reference remote and sets its skip-save flag.
+Actor* CreateProjectedActor(World& world,const CharacterSpawnRequest& spawn) noexcept
+{
+    const auto& base=spawn.LeveledNpcPickId!=GameId{}?spawn.LeveledNpcPickId:spawn.BaseId;
+    if (!base || HomeInstance::Tagged(base.ModId)) return nullptr;
+    auto* npc=Cast<TESNPC>(TESForm::GetById(world.GetModSystem().GetGameId(base)));
+    if (!npc || npc->IsTemporary()) return nullptr;
+    return Actor::Create(npc);
+}
